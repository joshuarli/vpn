  "topology": {
    "clear_netem": "ip netns exec c tc qdisc del dev vc root 2>/dev/null || true\nip netns exec s tc qdisc del dev vs root 2>/dev/null || true\n",
    "netem": {
      "burst_loss": "ip netns exec c tc qdisc replace dev vc root netem limit 100000 loss gemodel 1% 20% 100% 0% seed 1234\nip netns exec s tc qdisc replace dev vs root netem limit 100000 loss gemodel 1% 20% 100% 0% seed 1234\n",
      "delay": "ip netns exec c tc qdisc replace dev vc root netem limit 100000 delay 10ms\nip netns exec s tc qdisc replace dev vs root netem limit 100000 delay 10ms\n",
      "loss": "ip netns exec c tc qdisc replace dev vc root netem limit 100000 loss 1% seed 1234\nip netns exec s tc qdisc replace dev vs root netem limit 100000 loss 1% seed 1234\n",
      "mem_jitter": "ip netns exec c tc qdisc replace dev vc root netem limit 100000 delay 20ms 15ms seed 4242\nip netns exec s tc qdisc replace dev vs root netem limit 100000 delay 20ms 15ms seed 4242\n",
      "reorder_dup": "ip netns exec c tc qdisc replace dev vc root netem limit 100000 delay 5ms reorder 25% 50% duplicate 1% seed 1234\nip netns exec s tc qdisc replace dev vs root netem limit 100000 delay 5ms reorder 25% 50% duplicate 1% seed 1234\n"
    },
    "setup": {
      "1350": "mount -o remount,rw /proc/sys 2>/dev/null || true\nmkdir -p /dev/net; [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200\nip netns del c 2>/dev/null || true\nip netns del s 2>/dev/null || true\nip netns add c\nip netns add s\nip link add vc netns c type veth peer name vs netns s\nip -n c addr add 10.77.0.1/24 dev vc\nip -n s addr add 10.77.0.2/24 dev vs\nip -n c link set lo up\nip -n s link set lo up\nip -n c link set vc mtu 1350 up\nip -n s link set vs mtu 1350 up\nip -n c route add default via 10.77.0.2\nip -n s route add default via 10.77.0.1\n",
      "1500": "mount -o remount,rw /proc/sys 2>/dev/null || true\nmkdir -p /dev/net; [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200\nip netns del c 2>/dev/null || true\nip netns del s 2>/dev/null || true\nip netns add c\nip netns add s\nip link add vc netns c type veth peer name vs netns s\nip -n c addr add 10.77.0.1/24 dev vc\nip -n s addr add 10.77.0.2/24 dev vs\nip -n c link set lo up\nip -n s link set lo up\nip -n c link set vc mtu 1500 up\nip -n s link set vs mtu 1500 up\nip -n c route add default via 10.77.0.2\nip -n s route add default via 10.77.0.1\n",
      "9000": "mount -o remount,rw /proc/sys 2>/dev/null || true\nmkdir -p /dev/net; [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200\nip netns del c 2>/dev/null || true\nip netns del s 2>/dev/null || true\nip netns add c\nip netns add s\nip link add vc netns c type veth peer name vs netns s\nip -n c addr add 10.77.0.1/24 dev vc\nip -n s addr add 10.77.0.2/24 dev vs\nip -n c link set lo up\nip -n s link set lo up\nip -n c link set vc mtu 9000 up\nip -n s link set vs mtu 9000 up\nip -n c route add default via 10.77.0.2\nip -n s route add default via 10.77.0.1\n"
    },
    "teardown": "ip netns del c 2>/dev/null || true\nip netns del s 2>/dev/null || true\n"
